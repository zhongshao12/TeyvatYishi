{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "旅行者纪事",
  "version": "1.5.0",
  "identifier": "com.kaituoyishi.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev -- --host 127.0.0.1 --port 3000",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "旅行者纪事",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "KaiTuoYiShi",
    "shortDescription": "旅行者纪事 Desktop Edition",
    "longDescription": "可安装、可更新、本地数据优先的旅行者纪事桌面分支版本。",
    "resources": ["desktop"],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBM0FGRTRFMzFBN0ZCMTIKUldRUys2Y3hUdjQ2R21YSmhDS1M1RHNXeWIvUVZhY1dDam4rdndwc1hzT3VpRjZvQWJLeC92VVMK",
      "endpoints": [
        "https://github.com/zhongshao12/TeyvatYishi/releases/latest/download/latest.json"
      ]
    }
  }
}
